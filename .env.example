# Backend only. Copy to .env; never commit .env or put keys in NEXT_PUBLIC_*.
YINGYAN_ADMIN_USERNAME=director
YINGYAN_ADMIN_PASSWORD=local-director-change-me
DB_PASSWORD=local-database-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
COOKIE_SECURE=false
# Optional first-stage text assistance; no key is required for manual editing.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek TTS. Optional if OPENAI_BASE_URL uses https://api.deepseek.com:
# the backend then reuses OPENAI_API_KEY. Never send a key to the frontend.
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.deepseek.com
